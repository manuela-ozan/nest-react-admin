{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@craco/craco": "^7.0.0",
    "@tailwindcss/forms": "^0.5.7",
    "axios": "0.21.4",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.45.0",
    "react-query": "^3.39.3",
    "react-router-dom": "5.3.4",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@types/jest": "^27.0.0",
    "@types/minimatch": "^5.1.1",
    "@types/node": "^16.18.0",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.9",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.1.7",
    "autoprefixer": "^10.4.19",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "postcss": "^8.4.38",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.4"
  },
  "scripts": {
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && craco start",
    "build": "craco build",
    "test": "craco test",
    "test:coverage": "craco test --coverage --watchAll=false",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,json}",
    "type-check": "tsc --noEmit",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "simple-import-sort",
      "prettier"
    ],
    "rules": {
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error",
      "prettier/prettier": "error",
      "react-hooks/exhaustive-deps": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "minimatch": "^3.0.5",
    "**/minimatch": "^3.0.5",
    "loader-utils": "^2.0.4",
    "**/loader-utils": "^2.0.4",
    "immer": "^9.0.6",
    "**/immer": "^9.0.6",
    "braces": "^3.0.3",
    "**/braces": "^3.0.3",
    "nth-check": "^2.0.1",
    "**/nth-check": "^2.0.1",
    "micromatch": "^4.0.8",
    "**/micromatch": "^4.0.8",
    "semver": "^7.5.2",
    "**/semver": "^7.5.2",
    "cross-spawn": "^7.0.5",
    "**/cross-spawn": "^7.0.5",
    "shell-quote": "^1.7.3",
    "**/shell-quote": "^1.7.3",
    "ejs": "^3.1.10",
    "**/ejs": "^3.1.10",
    "ansi-html": "^0.0.8",
    "**/ansi-html": "^0.0.8",
    "rollup": "^2.79.2",
    "**/rollup": "^2.79.2",
    "node-forge": "^1.3.1",
    "**/node-forge": "^1.3.1",
    "lodash.template": "^4.5.0",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.9",
    "@types/react-router-dom": "^5.3.3"
  },
  "proxy": "http://localhost:5000",
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/index.tsx",
      "!src/reportWebVitals.ts"
    ]
  }
}
